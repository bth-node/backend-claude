meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("testEmail", `test-${Date.now()}@example.com`);
}

body:json {
  {
    "name": "Test User",
    "email": "{{testEmail}}",
    "password": "password123"
  }
}

assert {
  res.status: eq 201
  res.body.user.email: eq {{testEmail}}
}
